#!/bin/sh
# Fail-closed placeholder for the extended-device-support profile.
# Upstream Simple-CDD 0.6.9 executes executable .postinst inside /target
# during finish-install. Implementation must dispatch profiles in the
# agreed order regardless of the order returned by the selected multiselect.
set -eu
printf >&2 '%s\n' 'my-cdd extended-device-support: STOP — not production ready.'
printf >&2 '%s\n' 'Firmware and microcode require dynamic Backports-first package resolution, individual omission prompts and a simulated reviewed APT transaction.'
printf >&2 '%s\n' 'No automatic fallback, package install, or success state is permitted.'
exit 1
