<?xml version="1.0" encoding="UTF-8"?>
<!-- Optional labwc root menu: user-session commands only. -->
<openbox_menu>
  <menu id="root-menu">
    <item label="Terminal (foot)">
      <action name="Execute" command="foot" />
    </item>
    <item label="Firefox ESR">
      <action name="Execute" command="env MOZ_ENABLE_WAYLAND=1 firefox-esr" />
    </item>
    <item label="Files (Thunar)">
      <action name="Execute" command="env GDK_BACKEND=wayland thunar" />
    </item>
    <item label="Geany">
      <action name="Execute" command="env GDK_BACKEND=wayland geany" />
    </item>
    <separator />
    <!-- Labwc built-in window list, including minimized windows; no panel needed. -->
    <menu id="client-list-combined-menu" label="Running Windows" />
    <separator />
    <item label="Reconfigure">
      <action name="Reconfigure" />
    </item>
    <item label="Exit labwc (not the server)">
      <action name="Exit" />
    </item>
  </menu>
</openbox_menu>
